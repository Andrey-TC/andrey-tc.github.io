        <PAGEOBJECT XPOS="135.827617622177" YPOS="425.892561983471" OwnPage="0" ItemID="438614672" PTYPE="4" WIDTH="320.280015617883" HEIGHT="458.10769831457" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L320.28 0 L320.28 458.108 L0 458.108 L0 0 Z" copath="M0 0 L320.28 0 L320.28 458.108 L0 458.108 L0 0 Z" gXpos="135.827617622177" gYpos="425.892561983471" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Bookman Old Style Bold" CH="Sobre mí"/>
                <para ALIGN="1"/>
                <ITEXT FONT="Book Antiqua Regular" CH="Soy artista visual colombiano con más de 15 años de trayectoria profesional, especializado en dibujo, pintura y tatuaje realista. Mi obra se centra en el retrato y la figura humana, explorando el realismo desde una mirada emocional y técnica. Trabajo principalmente en óleo, influenciado por métodos clásicos, buscando capturar no solo la forma, sino la atmósfera y la tensión entre lo visible y lo invisible. Cada pieza es una exploración del silencio, la mirada y la intimidad."/>
                <para ALIGN="3"/>
                <para/>
                <ITEXT FONT="Bookman Old Style Bold" CH="Experiencia"/>
                <para ALIGN="1"/>
                <ITEXT FONT="Book Antiqua Regular" CH="He desarrollado una práctica artística independiente consolidada, enfocada en el realismo técnico y emocional a través del dibujo, la pintura y el tatuaje. A lo largo de los años, he trabajado con clientes de forma personalizada, gestionando proyectos visuales, y perfeccionando procesos de conceptualización y ejecución. Esta experiencia me ha permitido desarrollar habilidades pedagógicas como la transmisión de saberes técnicos, la comunicación efectiva y el acompañamiento creativo."/>
                <para ALIGN="3"/>
                <para/>
            </StoryText>
        </PAGEOBJECT>
        <PAGEOBJECT XPOS="62.182989523004" YPOS="363.330578512397" OwnPage="0" ItemID="438609008" PTYPE="5" WIDTH="414.464881889764" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.880514892224" PWIDTH="1" SHADE="0" PCOLOR2="Black" PLINEART="1" path="" gXpos="62.182989523004" gYpos="363.330578512397" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="47.182989523004" YPOS="369.330578512397" OwnPage="0" ItemID="438617504" PTYPE="5" WIDTH="414.464881889764" HEIGHT="1" FRTYPE="0" CLIPEDIT="0" ROT="359.880514892224" PWIDTH="1" SHADE="0" PCOLOR2="Black" PLINEART="1" path="" gXpos="47.182989523004" gYpos="369.330578512397" gWidth="0" gHeight="0" LAYER="0"/>
        <PAGEOBJECT XPOS="239.89871965901" YPOS="941.443938309367" OwnPage="1" ItemID="438623168" PTYPE="4" WIDTH="318.946752781934" HEIGHT="203.289256198345" FRTYPE="0" CLIPEDIT="0" PWIDTH="1" PLINEART="1" LOCALSCX="1" LOCALSCY="1" LOCALX="0" LOCALY="0" LOCALROT="0" PICART="1" SCALETYPE="1" RATIO="1" COLUMNS="1" COLGAP="0" AUTOTEXT="0" EXTRA="0" TEXTRA="0" BEXTRA="0" REXTRA="0" VAlign="0" FLOP="1" PLTSHOW="0" BASEOF="0" textPathType="0" textPathFlipped="0" path="M0 0 L318.947 0 L318.947 203.289 L0 203.289 L0 0 Z" copath="M0 0 L318.947 0 L318.947 203.289 L0 203.289 L0 0 Z" gXpos="239.89871965901" gYpos="941.443938309367" gWidth="0" gHeight="0" LAYER="0" NEXTITEM="-1" BACKITEM="-1">
            <StoryText>
                <DefaultStyle/>
                <ITEXT FONT="Bookman Old Style Bold" CH="Formación"/>
                <para ALIGN="1"/>
                <para ALIGN="1"/>
                <ITEXT FONT="Book Antiqua Regular" CH="Soy bachiller técnico industrial con especialización en diseño industrial, y comunicador gráfico con énfasis en diseño y mercadeo web. Paralelamente, he desarrollado una formación empírica avanzada en dibujo y pintura analógica y digital, así como en tatuajes. "/>
                <breakline/>
                <breakline/>
                <ITEXT FONT="Book Antiqua Regular" CH="Esta formación híbrida me permite integrar pensamiento técnico, sensibilidad estética y enfoque comunicativo en mi práctica y enseñanza."/>
                <para ALIGN="3"/>
            </StoryText>
        </PAGEOBJECT>
